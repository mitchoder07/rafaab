# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=file:./db/custom.db

# Paystack — get FREE test keys at https://dashboard.paystack.com/#/settings/keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public URL of your app (used for Paystack callback redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session secret for auth cookies (change this to a random string in production)
SESSION_SECRET=rafaab-dev-secret-change-in-production-9f2k4

# ===== Rafi AI Assistant =====
# Option 1: OpenAI (recommended, $5 free credit on signup)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Option 2: Groq (FREE, fast, uses Llama models)
# Get key: https://console.groq.com/keys
# Then set:
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# Option 3: Google Gemini (FREE tier)
# Get key: https://aistudio.google.com/apikey
# Then set:
# OPENAI_API_KEY=your_gemini_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-1.5-flash
